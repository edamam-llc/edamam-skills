#!/usr/bin/env bash
# Keep GEMINI.md in sync with SKILL.md. If SKILL.md is part of this commit,
# regenerate GEMINI.md and stage it so the two never drift.
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"

# Only run when the skill source is staged.
if git diff --cached --name-only | grep -q '^skills/edamam-barcode-lookup/SKILL.md$'; then
  bash "$repo_root/scripts/gen-gemini-md.sh"
  git add "$repo_root/GEMINI.md"
fi
